{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": { "api/index.js": { "includeFiles": "dist/**", "maxDuration": 60 } },
  "crons": [
    { "path": "/api/cron/study", "schedule": "0 13 * * 0" },
    { "path": "/api/cron/daily", "schedule": "0 14 * * *" }
  ]
}
