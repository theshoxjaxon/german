# Copy to .env.local and change what you need. Everything here is optional.

# Where the data lives. Leave empty for a local file (data/karteikasten.db).
# In production, a Turso database: libsql://<name>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# The first join code students need to sign up (the admin can change it later in /admin).
JOIN_CODE=

# Time zone for "today", streaks and daily active users.
APP_TIMEZONE=Asia/Tashkent
