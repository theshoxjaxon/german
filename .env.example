# The web app's settings. Copy to .env.local. The API has its own: see backend/.env.example.

# Where the NestJS API runs (backend/). The browser calls /api/* on this site and Next proxies it here.
# Locally: http://localhost:4000 (run `npm run dev:api`). On Vercel: the API project's address.
API_URL=http://localhost:4000

# Sign in with Google: the same OAuth Web client ID the API checks tokens against (public, not a secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Search engines (optional): the codes from each one's "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=

# Yandex Metrica (optional): your tag number. Built into the page, so redeploy after changing it.
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_YANDEX_WEBVISOR=
