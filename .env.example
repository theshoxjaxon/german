# Copy to .env.local and fill in DATABASE_URL. Never commit .env.local: it holds your database password.
# On Vercel, put the same names in Project → Settings → Environment Variables, then redeploy.

# Your Supabase database: Supabase → your project → Connect → "Connection string".
#   Vercel / serverless hosting → the "Transaction pooler" string (port 6543)
#   your laptop or a normal server → the "Session pooler" string (port 5432) works too
# Replace [YOUR-PASSWORD] (brackets included) with your database password. Special characters are fine.
# Example: postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional: also verify the database server's certificate. Supabase → Project Settings → Database →
# SSL Configuration → Download certificate; paste its text here with \n for the line breaks.
DATABASE_CA_CERT=

# Optional: database connections per server process (default 5).
DATABASE_POOL_MAX=

# Who is an admin (teacher): your email address, comma-separated for several. Such an address
# becomes admin once it's proven: by signing in with Google, or with a "Forgot password" link.
ADMIN_EMAILS=

# Sign in with Google: the OAuth 2.0 *Web* client ID from Google Cloud Console → APIs & Services →
# Credentials (it ends in .apps.googleusercontent.com). It is public, not a secret. No client
# secret is needed. Without it, the Google button is hidden. Changing it needs a rebuild/redeploy.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# "Forgot password" emails through Resend (https://resend.com → API Keys). Secret: keep it here
# and in Vercel only. Without it, during `npm run dev` the reset link is printed in the terminal.
RESEND_API_KEY=
# The sender, e.g. Karteikasten <noreply@your-domain.uz>. Its domain must be verified in Resend →
# Domains. Empty: Resend's test sender onboarding@resend.dev, which only delivers to your own
# Resend account's address.
EMAIL_FROM=

# The site's public address, for links in emails (no trailing slash). On Vercel it defaults to the
# production domain; set it if you use your own domain. Locally it is http://localhost:3000.
APP_URL=

# Optional: the AI word helper (photo of a word list → flashcards, "Fill in with AI").
# Create a key at https://console.anthropic.com → API keys. Without it the AI buttons are hidden.
ANTHROPIC_API_KEY=
# Optional: another Claude model (default claude-opus-5-5).
AI_MODEL=

# Time zone for "today", streaks and daily active users.
APP_TIMEZONE=Asia/Tashkent
